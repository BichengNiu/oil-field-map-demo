# Create .streamlit/secrets.toml locally or configure the same key in the
# Streamlit deployment settings. Never commit a real key.
AISSTREAM_API_KEY = "replace-with-your-server-side-key"

# Authorized custom-sea entry-event history (see SEA_HISTORY_INTEGRATION.md).
# Choose a local ZIP delivery OR an HTTPS ZIP delivery URL; these are NOT vendor
# API endpoints. Keep the event database on persistent storage in production.
# SEA_HISTORY_ARCHIVE_PATH = "/persistent-data/sea-history.sqlite3"
# SEA_HISTORY_BUNDLE_PATH = "/persistent-data/sea-history-delivery.zip"
# SEA_HISTORY_BUNDLE_URL = "https://your-authorized-delivery-host/sea-history.zip"
# SEA_HISTORY_BEARER_TOKEN = "your-delivery-token-if-required"
# SEA_HISTORY_IMPORT_TOKEN = "your-private-admin-import-password"
